#!/usr/bin/env -S uv run --script
# /// script
#
# requires-python = ">=3.10"
#
# dependencies = [
#   "trame>=3.13",
#   "trame-vuetify",
#   "trame-reveal",
# ]
#
# [[tool.uv.index]]
# url = "https://wheels.vtk.org"
#
# ///

from pathlib import Path

from trame.tools.reveal import SlideViewer


def main():
    app = SlideViewer(
        content=Path(__file__).with_name("index.html"),
        theme="white",
        config={},
    )
    app.server.start()


if __name__ == "__main__":
    main()
